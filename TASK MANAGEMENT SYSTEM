<script>

/* =========================================================
   TASK DATA
========================================================= */

const taskFlowVersion = "2.0";

const defaultTasks = [
    {
        id:101,
        title:"Build TaskFlow Dashboard",
        description:"Complete the Task Management System dashboard, analytics and responsive UI.",
        priority:"High", category:"Project", deadline:"2026-09-22", status:"working", starred:true
    },
    {
        id:102,
        title:"Java OOP Revision",
        description:"Revise classes, constructors, inheritance, packages and exception handling for the semester work.",
        priority:"High", category:"College", deadline:"2026-09-23", status:"todo", starred:true
    },
    {
        id:103,
        title:"STM32 Discrete PID Report",
        description:"Prepare the PID controller design, block diagram, equations and simulation explanation.",
        priority:"High", category:"Embedded", deadline:"2026-09-24", status:"working", starred:false
    },
    {
        id:104,
        title:"Machine Learning Assignment",
        description:"Finish Decision Tree, Random Forest, SVM and k-fold cross-validation notes.",
        priority:"Medium", category:"ML", deadline:"2026-09-25", status:"todo", starred:false
    },
    {
        id:105,
        title:"Agriculture Project Report",
        description:"Organize stakeholder findings, field activity, solutions and project documentation.",
        priority:"Medium", category:"Project", deadline:"2026-09-26", status:"working", starred:false
    },
    {
        id:106,
        title:"Prepare Viva Questions",
        description:"Review short viva answers for UART, STM32 interrupts and embedded applications.",
        priority:"Medium", category:"College", deadline:"2026-09-20", status:"completed", starred:false
    },
    {
        id:107,
        title:"Test Task Drag and Drop",
        description:"Verify To-Do, Working and Completed task movement and LocalStorage persistence.",
        priority:"Low", category:"Coding", deadline:"2026-09-19", status:"completed", starred:false
    }
];

let tasks =
    localStorage.getItem("taskFlowVersion") === taskFlowVersion
    ? JSON.parse(localStorage.getItem("taskFlowTasks") || "[]")
    : defaultTasks;

localStorage.setItem("taskFlowVersion", taskFlowVersion);

if(!Array.isArray(tasks) || tasks.length === 0){
    tasks = defaultTasks;
}

let editingId = null;

let draggedTaskId = null;


/* =========================================================
   SAVE
========================================================= */

function saveTasks(){

    localStorage.setItem(
        "taskFlowTasks",
        JSON.stringify(tasks)
    );

}


/* =========================================================
   QUICK ADD
========================================================= */

function quickAddTask(){

    const title =
        document
        .getElementById("quickTitle")
        .value
        .trim();


    if(!title){

        notify(
            "⚠️ Please enter a task title."
        );

        return;
    }


    const task = {

        id:Date.now(),

        title:title,

        description:
            "Task created from the dashboard.",

        priority:
            document
            .getElementById("quickPriority")
            .value,

        category:
            document
            .getElementById("quickCategory")
            .value,

        deadline:
            document
            .getElementById("quickDeadline")
            .value,

        status:"todo",

        starred:false

    };


    tasks.push(task);

    saveTasks();

    document
        .getElementById("quickTitle")
        .value="";

    document
        .getElementById("quickDeadline")
        .value="";


    renderTasks();

    notify(
        "✅ New task added successfully!"
    );

}


/* =========================================================
   MODAL
========================================================= */

function showModal(id=null){

    editingId=id;

    document
        .getElementById("taskModal")
        .classList
        .add("show");


    if(id){

        const task =
            tasks.find(
                t=>t.id===id
            );


        document
            .getElementById("modalTitle")
            .textContent =
            "✏️ Edit Task";


        document
            .getElementById("taskTitle")
            .value =
            task.title;


        document
            .getElementById("taskDescription")
            .value =
            task.description;


        document
            .getElementById("taskPriority")
            .value =
            task.priority;


        document
            .getElementById("taskCategory")
            .value =
            task.category;


        document
            .getElementById("taskDeadline")
            .value =
            task.deadline;


        document
            .getElementById("taskStatus")
            .value =
            task.status;

    }

    else{

        document
            .getElementById("modalTitle")
            .textContent =
            "➕ Add New Task";


        document
            .getElementById("taskForm")
            .reset();

    }

}


/* =========================================================
   CLOSE MODAL
========================================================= */

function closeModal(){

    document
        .getElementById("taskModal")
        .classList
        .remove("show");

    editingId=null;

}


/* =========================================================
   FORM SUBMIT
========================================================= */

document
    .getElementById("taskForm")
    .addEventListener(
        "submit",
        function(e){

            e.preventDefault();


            const data={

                title:
                    document
                    .getElementById("taskTitle")
                    .value
                    .trim(),

                description:
                    document
                    .getElementById("taskDescription")
                    .value
                    .trim(),

                priority:
                    document
                    .getElementById("taskPriority")
                    .value,

                category:
                    document
                    .getElementById("taskCategory")
                    .value,

                deadline:
                    document
                    .getElementById("taskDeadline")
                    .value,

                status:
                    document
                    .getElementById("taskStatus")
                    .value

            };


            if(editingId){

                const task =
                    tasks.find(
                        t=>t.id===editingId
                    );


                Object.assign(
                    task,
                    data
                );


                notify(
                    "✏️ Task updated successfully!"
                );

            }

            else{

                tasks.push({

                    id:Date.now(),

                    ...data,

                    starred:false

                });


                notify(
                    "✅ New task added successfully!"
                );

            }


            saveTasks();

            closeModal();

            renderTasks();

        }
    );


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(str){

    return String(str)

        .replaceAll(
            "&",
            "&amp;"
        )

        .replaceAll(
            "<",
            "&lt;"
        )

        .replaceAll(
            ">",
            "&gt;"
        )

        .replaceAll(
            '"',
            "&quot;"
        )

        .replaceAll(
            "'",
            "&#039;"
        );

}


/* =========================================================
   RENDER TASKS
========================================================= */

function renderTasks(){

    const todo =
        document
        .getElementById("todoTasks");


    const working =
        document
        .getElementById("workingTasksBoard");


    const completed =
        document
        .getElementById("completedTasksBoard");


    todo.innerHTML="";

    working.innerHTML="";

    completed.innerHTML="";


    const search =
        document
        .getElementById("searchInput")
        .value
        .toLowerCase();


    const priority =
        document
        .getElementById("priorityFilter")
        .value;


    const category =
        document
        .getElementById("categoryFilter")
        .value;


    const filtered =
        tasks.filter(task=>{

            const text =
                (
                    task.title+
                    " "+
                    task.description+
                    " "+
                    task.category
                ).toLowerCase();


            const matchSearch =
                text.includes(search);


            const matchPriority =
                priority==="all" ||
                task.priority===priority;


            const matchCategory =
                category==="all" ||
                task.category===category;


            return(
                matchSearch &&
                matchPriority &&
                matchCategory
            );

        });


    filtered.forEach(task=>{

        const card =
            createTaskCard(task);


        if(task.status==="todo")
            todo.appendChild(card);


        if(task.status==="working")
            working.appendChild(card);


        if(task.status==="completed")
            completed.appendChild(card);

    });


    if(!todo.children.length){

        todo.innerHTML =
            '<div class="empty">📝 No To-Do tasks</div>';

    }


    if(!working.children.length){

        working.innerHTML =
            '<div class="empty">⚡ No working tasks</div>';

    }


    if(!completed.children.length){

        completed.innerHTML =
            '<div class="empty">✅ No completed tasks</div>';

    }


    updateStats();
    updateCharts();

}


/* =========================================================
   CREATE TASK CARD
========================================================= */

function createTaskCard(task){

    const div =
        document.createElement("div");


    div.className="task";


    div.draggable=true;


    div.ondragstart =
        e=>dragStart(
            e,
            task.id
        );


    const overdue =
        task.deadline &&
        new Date(task.deadline+"T23:59:59")
        <
        new Date() &&
        task.status!=="completed";


    div.innerHTML=`

        <div class="task-top">

            <div class="task-title">

                ${escapeHTML(task.title)}

            </div>


            <button
                class="star ${task.starred?"active":""}"
                onclick="toggleStar(${task.id})">

                ${task.starred?"★":"☆"}

            </button>

        </div>


        <div class="task-description">

            ${escapeHTML(
                task.description ||
                "No description"
            )}

        </div>


        <div class="task-meta">

            <span
                class="badge priority-${task.priority.toLowerCase()}">

                ${task.priority}

            </span>


            <span class="badge">

                ${task.category}

            </span>


            ${
                task.deadline
                ?
                `<span
                    class="badge ${overdue?"priority-high":""}">
                    📅 ${task.deadline}
                </span>`
                :
                ""
            }


            ${
                overdue
                ?
                `<span
                    class="badge priority-high">
                    ⚠️ Overdue
                </span>`
                :
                ""
            }

        </div>


        <div class="task-actions">

            <button
                onclick="editTask(${task.id})">

                ✏️ Edit

            </button>


            <button
                onclick="deleteTask(${task.id})">

                🗑️ Delete

            </button>

        </div>

    `;


    return div;

}


/* =========================================================
   EDIT
========================================================= */

function editTask(id){

    showModal(id);

}


/* =========================================================
   DELETE
========================================================= */

function deleteTask(id){

    if(
        !confirm(
            "Are you sure you want to delete this task?"
        )
    ){

        return;

    }


    tasks =
        tasks.filter(
            t=>t.id!==id
        );


    saveTasks();

    renderTasks();

    notify(
        "🗑️ Task deleted successfully."
    );

}


/* =========================================================
   STAR
========================================================= */

function toggleStar(id){

    const task =
        tasks.find(
            t=>t.id===id
        );


    if(!task)
        return;


    task.starred =
        !task.starred;


    saveTasks();

    renderTasks();


    notify(
        task.starred
        ?
        "⭐ Task marked as important."
        :
        "Task removed from important."
    );

}


/* =========================================================
   DRAG
========================================================= */

function dragStart(e,id){

    draggedTaskId=id;

    e.dataTransfer.effectAllowed =
        "move";

}


function allowDrop(e){

    e.preventDefault();

}


function dropTask(e,status){

    e.preventDefault();


    const task =
        tasks.find(
            t=>t.id===draggedTaskId
        );


    if(!task)
        return;


    task.status=status;


    saveTasks();

    renderTasks();


    const name =
        status==="todo"
        ?
        "To-Do"
        :
        status==="working"
        ?
        "Working"
        :
        "Completed";


    notify(
        "📌 Task moved to "+name
    );

}


/* =========================================================
   STATISTICS
========================================================= */

function updateStats(){

    const total =
        tasks.length;


    const working =
        tasks.filter(
            t=>t.status==="working"
        ).length;


    const completed =
        tasks.filter(
            t=>t.status==="completed"
        ).length;


    const todo =
        tasks.filter(
            t=>t.status==="todo"
        ).length;


    const overdue =
        tasks.filter(
            t=>
                t.deadline &&
                new Date(
                    t.deadline+"T23:59:59"
                ) <
                new Date() &&
                t.status!=="completed"
        ).length;


    document
        .getElementById("totalTasks")
        .textContent=total;


    document
        .getElementById("workingTasks")
        .textContent=working;


    document
        .getElementById("completedTasks")
        .textContent=completed;


    document
        .getElementById("overdueTasks")
        .textContent=overdue;


    document
        .getElementById("todoCount")
        .textContent=todo;


    document
        .getElementById("workingCount")
        .textContent=working;


    document
        .getElementById("completedCount")
        .textContent=completed;


    const percent =
        total===0
        ?
        0
        :
        Math.round(
            completed/total*100
        );


    document
        .getElementById("progressBar")
        .style.width=
        percent+"%";


    document
        .getElementById("progressText")
        .textContent=
        percent+"% Complete";

}


/* =========================================================
   SIDEBAR FILTER
========================================================= */

function filterStatus(status){

    document
        .getElementById("searchInput")
        .value="";


    document
        .getElementById("priorityFilter")
        .value="all";


    document
        .getElementById("categoryFilter")
        .value="all";


    renderTasks();


    const element =
        status==="todo"
        ?
        document.querySelector(".todo-column")
        :
        status==="working"
        ?
        document.querySelector(".working-column")
        :
        document.querySelector(".completed-column");


    element.scrollIntoView({
        behavior:"smooth",
        block:"center"
    });

}


/* =========================================================
   DASHBOARD
========================================================= */

function goDashboard(element){

    document
        .querySelectorAll(".nav-item")
        .forEach(
            item=>
                item.classList.remove("active")
        );


    element.classList.add("active");


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =========================================================
   DARK / LIGHT MODE
========================================================= */

function toggleTheme(){

    document
        .body
        .classList
        .toggle("light");


    const light =
        document
        .body
        .classList
        .contains("light");


    localStorage.setItem(
        "taskFlowTheme",
        light
        ?
        "light"
        :
        "dark"
    );


    document
        .getElementById("themeButton")
        .textContent =
        light
        ?
        "☀️"
        :
        "🌙";

    updateCharts();

}


/* LOAD THEME */

if(
    localStorage.getItem(
        "taskFlowTheme"
    )
    ===
    "light"
){

    document
        .body
        .classList
        .add("light");


    document
        .getElementById("themeButton")
        .textContent="☀️";

}


/* =========================================================
   CLOCK
========================================================= */

function updateTime(){

    const now =
        new Date();


    const date =
        now.toLocaleDateString(
            "en-IN",
            {
                day:"2-digit",
                month:"short",
                year:"numeric"
            }
        );


    const time =
        now.toLocaleTimeString(
            "en-IN",
            {
                hour:"2-digit",
                minute:"2-digit",
                second:"2-digit"
            }
        );


    document
        .getElementById("currentTime")
        .textContent =
        date+
        " • "+
        time;

}


setInterval(
    updateTime,
    1000
);


updateTime();


/* =========================================================
   NOTIFICATION
========================================================= */

function notify(message){

    const box =
        document
        .getElementById("notification");


    document
        .getElementById("notificationText")
        .textContent=message;


    box.classList.add("show");


    setTimeout(
        ()=>{
            box.classList.remove("show");
        },
        3000
    );

}


/* =========================================================
   NOTIFICATIONS
========================================================= */

function showNotifications(){

    const overdue =
        tasks.filter(
            t=>
                t.deadline &&
                new Date(
                    t.deadline+"T23:59:59"
                ) <
                new Date() &&
                t.status!=="completed"
        ).length;


    if(overdue>0){

        notify(
            "⚠️ You have "+
            overdue+
            " overdue task(s)."
        );

    }

    else{

        notify(
            "🎉 No overdue tasks. Great work!"
        );

    }

}


/* =========================================================
   TASK ANALYTICS
========================================================= */

let statusChart = null;
let priorityChart = null;
let trendChart = null;

function chartTheme(){
    const light = document.body.classList.contains("light");
    return {
        text: light ? "#24364d" : "#dce8f8",
        grid: light ? "rgba(30,60,100,.10)" : "rgba(255,255,255,.08)"
    };
}

function updateCharts(){
    if(typeof Chart === "undefined") return;

    const theme = chartTheme();

    const statusData = [
        tasks.filter(t=>t.status==="todo").length,
        tasks.filter(t=>t.status==="working").length,
        tasks.filter(t=>t.status==="completed").length
    ];

    const priorityData = [
        tasks.filter(t=>t.priority==="High").length,
        tasks.filter(t=>t.priority==="Medium").length,
        tasks.filter(t=>t.priority==="Low").length
    ];

    const completedByDate = {};
    tasks.forEach(t=>{
        if(t.status === "completed"){
            const d = t.deadline || "No date";
            completedByDate[d] = (completedByDate[d] || 0) + 1;
        }
    });

    let trendLabels = Object.keys(completedByDate).filter(x=>x!=="No date").sort();
    let trendValues = trendLabels.map(d=>completedByDate[d]);

    if(trendLabels.length === 0){
        trendLabels = ["Current"];
        trendValues = [0];
    }

    [statusChart, priorityChart, trendChart].forEach(c=>{
        if(c) c.destroy();
    });

    statusChart = new Chart(document.getElementById("statusChart"), {
        type:"doughnut",
        data:{
            labels:["To-Do","Working","Completed"],
            datasets:[{ data:statusData, borderWidth:0 }]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            cutout:"65%",
            plugins:{
                legend:{position:"bottom", labels:{color:theme.text, padding:16, usePointStyle:true}}
            }
        }
    });

    priorityChart = new Chart(document.getElementById("priorityChart"), {
        type:"bar",
        data:{
            labels:["High","Medium","Low"],
            datasets:[{ label:"Tasks", data:priorityData, borderRadius:8, borderSkipped:false }]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            scales:{
                x:{ticks:{color:theme.text}, grid:{display:false}},
                y:{beginAtZero:true, ticks:{color:theme.text, precision:0}, grid:{color:theme.grid}}
            },
            plugins:{legend:{display:false}}
        }
    });

    trendChart = new Chart(document.getElementById("trendChart"), {
        type:"line",
        data:{
            labels:trendLabels,
            datasets:[{ label:"Completed tasks", data:trendValues, tension:.35, fill:true, pointRadius:5 }]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            scales:{
                x:{ticks:{color:theme.text}, grid:{color:theme.grid}},
                y:{beginAtZero:true, ticks:{color:theme.text, precision:0}, grid:{color:theme.grid}}
            },
            plugins:{legend:{labels:{color:theme.text, usePointStyle:true}}}
        }
    });
}

/* =========================================================
   MODAL CLICK OUTSIDE
========================================================= */

document
    .getElementById("taskModal")
    .addEventListener(
        "click",
        function(e){

            if(
                e.target===this
            ){

                closeModal();

            }

        }
    );


/* =========================================================
   ESC KEY
========================================================= */

document
    .addEventListener(
        "keydown",
        function(e){

            if(
                e.key==="Escape"
            ){

                closeModal();

            }

        }
    );


/* =========================================================
   INITIAL RENDER
========================================================= */

renderTasks();

</script>


