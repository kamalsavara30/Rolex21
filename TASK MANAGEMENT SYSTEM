<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Task Management System | TaskFlow</title>

<style>

/* =========================================================
   GLOBAL
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

:root{
    --project-bg:url("data:image/jpeg;base64,");
    --bg:#07111f;
    --bg2:#0b1729;
    --panel:rgba(15,28,48,.86);
    --panel2:rgba(10,22,40,.92);
    --border:rgba(255,255,255,.13);

    --text:#f7f9ff;
    --muted:#9fb0c7;

    --blue:#4da3ff;
    --cyan:#00e5ff;
    --purple:#9568ff;
    --green:#27df8b;
    --orange:#ffb84d;
    --red:#ff5d6c;

    --shadow:0 20px 60px rgba(0,0,0,.38);
}

body.light{
    --bg:#eef4fb;
    --bg2:#f7faff;
    --panel:rgba(255,255,255,.90);
    --panel2:rgba(255,255,255,.96);
    --border:rgba(20,55,100,.13);

    --text:#13243a;
    --muted:#60738a;

    --shadow:0 15px 45px rgba(42,75,110,.15);
}

body{
    font-family:
        Inter,
        Arial,
        Helvetica,
        sans-serif;

    min-height:100vh;

    color:var(--text);

    background:
        radial-gradient(
            circle at 10% 10%,
            rgba(0,229,255,.10),
            transparent 25%
        ),
        radial-gradient(
            circle at 90% 15%,
            rgba(149,104,255,.12),
            transparent 30%
        ),
        var(--bg);

    overflow-x:hidden;

    transition:
        background .35s ease,
        color .35s ease;
}

/* =========================================================
   BACKGROUND GRID
========================================================= */

body:before{
    content:"";
    position:fixed;
    inset:0;

    pointer-events:none;

    opacity:.07;

    background-image:
        linear-gradient(
            rgba(77,163,255,.35) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(77,163,255,.35) 1px,
            transparent 1px
        );

    background-size:45px 45px;

    z-index:-1;
}

/* =========================================================
   SIDEBAR
========================================================= */

.sidebar{
    position:fixed;

    left:0;
    top:0;
    bottom:0;

    width:270px;

    padding:24px 18px;

    background:
        linear-gradient(
            180deg,
            rgba(3,14,29,.97),
            rgba(4,17,32,.94)
        );

    border-right:1px solid var(--border);

    z-index:100;

    display:flex;
    flex-direction:column;

    backdrop-filter:blur(25px);
}

body.light .sidebar{
    background:rgba(255,255,255,.94);
}

/* LOGO */

.logo{
    display:flex;
    align-items:center;
    gap:13px;

    margin-bottom:38px;

    padding:0 4px;
}

.logo-icon{
    width:46px;
    height:46px;

    border-radius:14px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:24px;
    font-weight:900;

    color:white;

    background:
        linear-gradient(
            135deg,
            #45a9ff,
            #9568ff
        );

    box-shadow:
        0 0 35px rgba(77,163,255,.35);
}

.logo-text{
    font-size:21px;
    font-weight:800;
}

/* NAV TITLE */

.nav-title{
    color:#93a8c2;

    font-size:11px;

    text-transform:uppercase;

    letter-spacing:2px;

    margin:18px 10px 10px;
}

/* NAV ITEM */

.nav-item{
    display:flex;
    align-items:center;

    gap:13px;

    padding:14px 14px;

    margin:5px 0;

    border-radius:13px;

    color:#a5b5ca;

    cursor:pointer;

    transition:.25s;

    user-select:none;
}

.nav-item:hover{
    color:white;

    background:
        linear-gradient(
            90deg,
            rgba(77,163,255,.18),
            rgba(149,104,255,.12)
        );

    transform:translateX(3px);
}

.nav-item.active{
    color:white;

    background:
        linear-gradient(
            90deg,
            #1767cf,
            #3b55d9
        );

    box-shadow:
        0 10px 30px rgba(36,101,220,.25);
}

.nav-icon{
    width:25px;

    text-align:center;

    font-size:20px;
}

.profile{
    display:flex;
    align-items:center;

    gap:12px;

    margin-top:auto;

    padding:14px 7px;
}

.profile-photo{
    width:48px;
    height:48px;

    border-radius:50%;

    overflow:hidden;

    display:flex;
    align-items:center;
    justify-content:center;

    background:
        linear-gradient(
            135deg,
            #308dff,
            #9465ff
        );

    border:2px solid rgba(255,255,255,.25);
}

.profile-photo img{
    width:100%;
    height:100%;

    object-fit:cover;
}

.profile-name{
    font-size:14px;
    font-weight:700;
}

.profile-role{
    color:#91a5bf;

    font-size:11px;

    margin-top:4px;
}

/* =========================================================
   MAIN
========================================================= */

.main{
    margin-left:270px;

    min-height:100vh;

    position:relative;

    background:
        linear-gradient(
            90deg,
            rgba(7,17,31,.88) 0%,
            rgba(7,17,31,.66) 42%,
            rgba(7,17,31,.34) 100%
        ),
        var(--project-bg)
        center center / cover no-repeat;

    background-attachment:fixed;

    isolation:isolate;
}

body.light .main{
    background:
        linear-gradient(
            90deg,
            rgba(238,245,252,.84) 0%,
            rgba(238,245,252,.65) 45%,
            rgba(238,245,252,.35) 100%
        ),
        var(--project-bg)
        center center / cover no-repeat;

    background-attachment:fixed;
}

.main:after{
    content:"";

    position:absolute;

    inset:0;

    z-index:-1;

    background:
        linear-gradient(
            180deg,
            rgba(5,13,26,.18),
            rgba(5,13,26,.62)
        );

    pointer-events:none;
}

/* =========================================================
   CONTENT
========================================================= */

.content{
    padding:32px;
    max-width:1700px;
    margin:auto;
}

/* =========================================================
   HEADER
========================================================= */

.header{
    display:flex;

    justify-content:space-between;
    align-items:flex-start;

    gap:20px;

    margin-bottom:30px;
}

.title h1{
    font-size:38px;

    font-weight:850;

    letter-spacing:-1px;

    text-shadow:
        0 4px 25px rgba(0,0,0,.3);
}

.title p{
    margin-top:8px;

    color:#a7bbd4;

    font-size:15px;
}

body.light .title p{
    color:var(--muted);
}

.header-right{
    display:flex;

    align-items:center;

    gap:10px;
}

.time-box{
    padding:13px 17px;

    border:1px solid var(--border);

    background:var(--panel);

    backdrop-filter:blur(20px);

    border-radius:14px;

    color:#bdcce0;

    font-size:13px;

    box-shadow:var(--shadow);
}

.theme-btn{
    width:48px;
    height:48px;

    border-radius:14px;

    border:1px solid var(--border);

    background:var(--panel);

    color:var(--text);

    cursor:pointer;

    font-size:19px;

    transition:.25s;
}

.theme-btn:hover{
    transform:translateY(-2px) scale(1.04);
}

/* =========================================================
   WELCOME CARD
========================================================= */

.welcome{
    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:25px;

    margin-bottom:25px;

    padding:22px 25px;

    border:1px solid var(--border);

    border-radius:22px;

    background:
        linear-gradient(
            135deg,
            rgba(10,27,49,.83),
            rgba(27,22,60,.72)
        );

    backdrop-filter:blur(20px);

    box-shadow:var(--shadow);
}

body.light .welcome{
    background:rgba(255,255,255,.84);
}

.welcome-left h2{
    font-size:22px;
    margin-bottom:8px;
}

.welcome-left p{
    color:var(--muted);
    font-size:13px;
}

.welcome-user{
    display:flex;

    align-items:center;

    gap:14px;

    padding:10px 18px;

    border-radius:18px;

    background:rgba(255,255,255,.07);

    border:1px solid var(--border);
}

.welcome-user img{
    width:58px;
    height:58px;

    border-radius:50%;

    object-fit:cover;

    border:3px solid white;
}

.welcome-user strong{
    display:block;
    margin-bottom:4px;
}

.welcome-user span{
    color:var(--muted);
    font-size:12px;
}

/* =========================================================
   STATS
========================================================= */

.stats{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:18px;

    margin-bottom:25px;
}

.stat{
    position:relative;

    overflow:hidden;

    padding:22px;

    border:1px solid var(--border);

    border-radius:21px;

    background:var(--panel);

    backdrop-filter:blur(20px);

    box-shadow:var(--shadow);

    transition:.25s;
}

.stat:hover{
    transform:translateY(-4px);
}

.stat:after{
    content:"";

    position:absolute;

    width:120px;
    height:120px;

    right:-50px;
    top:-50px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(77,163,255,.25),
            transparent 70%
        );
}

.stat-icon{
    font-size:25px;

    margin-bottom:13px;
}

.stat-value{
    font-size:31px;

    font-weight:850;
}

.stat-label{
    margin-top:5px;

    color:var(--muted);

    font-size:13px;
}

/* =========================================================
   PRODUCTIVITY
========================================================= */

.productivity{
    padding:21px;

    margin-bottom:25px;

    border-radius:21px;

    border:1px solid var(--border);

    background:var(--panel);

    backdrop-filter:blur(20px);

    box-shadow:var(--shadow);
}

.productivity-head{
    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:14px;
}

.productivity-head strong{
    font-size:16px;
}

.productivity-head span{
    color:#a9bdd5;

    font-size:13px;
}

.progress{
    width:100%;

    height:11px;

    background:
        rgba(255,255,255,.08);

    border-radius:30px;

    overflow:hidden;
}

.progress-bar{
    width:0;

    height:100%;

    background:
        linear-gradient(
            90deg,
            var(--cyan),
            var(--blue),
            var(--purple)
        );

    border-radius:30px;

    transition:.6s ease;
}

/* =========================================================
   ANALYTICS + SYSTEM USES
========================================================= */

.analytics-section,
.uses-section{
    margin-bottom:25px;
    padding:22px;
    border-radius:22px;
    border:1px solid var(--border);
    background:var(--panel);
    backdrop-filter:blur(20px);
    box-shadow:var(--shadow);
}

.section-heading{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    margin-bottom:18px;
}

.section-heading h3{
    font-size:19px;
    margin-bottom:5px;
}

.section-heading p{
    color:var(--muted);
    font-size:12px;
}

.analytics-live{
    color:var(--green);
    font-size:11px;
    font-weight:800;
    padding:8px 12px;
    border-radius:20px;
    background:rgba(39,223,139,.08);
    border:1px solid rgba(39,223,139,.20);
}

.chart-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:16px;
}

.chart-card{
    min-height:290px;
    padding:18px;
    border-radius:18px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.035);
}

.chart-wide{
    grid-column:1 / -1;
}

.chart-title{
    font-weight:800;
    font-size:15px;
}

.chart-subtitle{
    color:var(--muted);
    font-size:11px;
    margin-top:4px;
}

.chart-box{
    position:relative;
    height:205px;
    margin-top:12px;
}

.trend-box{
    height:230px;
}

.use-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
}

.use-card{
    display:flex;
    gap:13px;
    align-items:flex-start;
    padding:16px;
    border-radius:17px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.035);
    transition:.25s;
}

.use-card:hover{
    transform:translateY(-3px);
    border-color:rgba(77,163,255,.35);
}

.use-card > span{
    font-size:25px;
}

.use-card strong{
    display:block;
    margin-bottom:5px;
    font-size:13px;
}

.use-card p{
    color:var(--muted);
    font-size:11px;
    line-height:1.55;
}

/* =========================================================
   ADD TASK AREA
========================================================= */

.add-panel{
    padding:22px;

    margin-bottom:20px;

    border-radius:21px;

    border:1px solid var(--border);

    background:var(--panel);

    backdrop-filter:blur(20px);

    box-shadow:var(--shadow);
}

.add-title{
    display:flex;

    align-items:center;

    gap:10px;

    font-size:18px;

    font-weight:800;

    margin-bottom:15px;
}

.quick-form{
    display:grid;

    grid-template-columns:
        2fr
        1fr
        1fr
        1fr
        auto;

    gap:10px;
}

.input,
.select{
    width:100%;

    padding:13px 14px;

    border-radius:12px;

    border:1px solid var(--border);

    outline:none;

    background:
        rgba(255,255,255,.06);

    color:var(--text);

    font-size:13px;
}

.input::placeholder{
    color:#8fa1b8;
}

.select option{
    color:#111;
    background:white;
}

.add-btn{
    border:0;

    padding:13px 20px;

    border-radius:12px;

    color:white;

    font-weight:750;

    cursor:pointer;

    background:
        linear-gradient(
            135deg,
            var(--blue),
            var(--purple)
        );

    box-shadow:
        0 8px 25px rgba(104,91,255,.25);

    transition:.25s;
}

.add-btn:hover{
    transform:translateY(-2px);

    box-shadow:
        0 12px 30px rgba(104,91,255,.35);
}

/* =========================================================
   TOOLBAR
========================================================= */

.toolbar{
    display:flex;

    gap:10px;

    margin-bottom:20px;

    flex-wrap:wrap;
}

.search{
    flex:1;

    min-width:250px;
}

.toolbar .select{
    width:165px;
}

/* =========================================================
   BOARD OUTER
========================================================= */

.board-wrapper{
    padding:10px;

    border-radius:28px;

    border:1px solid var(--border);

    background:
        rgba(5,15,30,.42);

    backdrop-filter:blur(10px);

    box-shadow:var(--shadow);
}

body.light .board-wrapper{
    background:rgba(255,255,255,.45);
}

/* =========================================================
   BOARD
========================================================= */

.board{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:16px;
}

/* =========================================================
   COLUMNS
========================================================= */

.column{
    position:relative;

    min-height:500px;

    padding:18px;

    overflow:hidden;

    border-radius:23px;

    border:1px solid rgba(255,255,255,.14);

    box-shadow:
        inset 0 0 40px rgba(0,0,0,.12);
}

.todo-column{
    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(0,229,255,.20),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            rgba(0,73,111,.91),
            rgba(5,21,44,.95)
        );
}

.working-column{
    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(149,104,255,.23),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            rgba(53,23,111,.91),
            rgba(13,11,42,.96)
        );
}

.completed-column{
    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(39,224,138,.21),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            rgba(4,91,73,.91),
            rgba(5,28,36,.96)
        );
}

/* =========================================================
   AI SCENE
========================================================= */

.ai-scene{
    height:170px;

    position:relative;

    margin:-3px -3px 12px;

    border-radius:19px;

    overflow:hidden;

    background:
        linear-gradient(
            180deg,
            rgba(0,0,0,.05),
            rgba(0,0,0,.22)
        );
}

/* CIRCUIT LINES */

.ai-scene:before{
    content:"";

    position:absolute;

    inset:0;

    opacity:.25;

    background-image:
        radial-gradient(
            circle,
            rgba(255,255,255,.5) 1px,
            transparent 2px
        );

    background-size:30px 30px;
}

/* MONITOR */

.screen{
    position:absolute;

    width:135px;
    height:78px;

    top:28px;
    left:25px;

    border:5px solid #7188a5;

    border-radius:10px;

    background:#061323;

    box-shadow:
        0 0 25px rgba(0,229,255,.18);
}

.screen:after{
    content:"";

    position:absolute;

    left:13px;
    right:13px;

    top:20px;

    height:4px;

    background:var(--cyan);

    box-shadow:
        0 13px var(--purple),
        0 26px var(--green);
}

/* PERSON */

.ai-person{
    position:absolute;

    left:50%;

    bottom:-15px;

    transform:translateX(-50%);

    width:92px;
    height:115px;
}

.ai-head{
    width:58px;
    height:58px;

    margin:auto;

    border-radius:50%;

    background:
        linear-gradient(
            135deg,
            #c5edff,
            #648aff
        );

    box-shadow:
        0 0 25px rgba(0,229,255,.5);
}

.ai-body{
    width:92px;
    height:76px;

    margin-top:-3px;

    border-radius:
        40px 40px 7px 7px;

    background:
        linear-gradient(
            135deg,
            #258eff,
            #724cff
        );
}

/* ROBOT */

.robot{
    position:absolute;

    right:26px;

    bottom:17px;

    width:45px;
    height:58px;

    border-radius:11px;

    background:
        linear-gradient(
            135deg,
            #a0b6ce,
            #364c64
        );

    box-shadow:
        0 8px 20px rgba(0,0,0,.3);
}

.robot:before{
    content:"";

    position:absolute;

    width:8px;
    height:8px;

    border-radius:50%;

    background:var(--cyan);

    left:9px;
    top:15px;

    box-shadow:
        18px 0 var(--cyan);
}

.robot:after{
    content:"";

    position:absolute;

    width:15px;
    height:3px;

    border-radius:5px;

    background:#18293c;

    left:15px;

    bottom:13px;
}

/* COMPLETION CHECK */

.check{
    position:absolute;

    left:50%;

    top:45%;

    transform:
        translate(-50%,-50%);

    font-size:76px;

    color:var(--green);

    text-shadow:
        0 0 35px rgba(39,224,138,.75);
}

/* =========================================================
   COLUMN TITLE
========================================================= */

.column-title{
    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:15px;
}

.column-title h2{
    font-size:18px;

    font-weight:800;
}

.count{
    min-width:31px;

    text-align:center;

    padding:6px 9px;

    border-radius:20px;

    background:
        rgba(255,255,255,.10);

    color:#c4d2e5;

    font-size:12px;
}

/* =========================================================
   TASKS
========================================================= */

.tasks{
    min-height:240px;
}

.task{
    padding:16px;

    margin-bottom:12px;

    border-radius:16px;

    border:1px solid rgba(255,255,255,.11);

    background:
        rgba(0,0,0,.27);

    backdrop-filter:blur(14px);

    cursor:grab;

    transition:.25s;
}

.task:hover{
    transform:translateY(-3px);

    border-color:
        rgba(77,163,255,.5);

    box-shadow:
        0 12px 30px rgba(0,0,0,.18);
}

.task:active{
    cursor:grabbing;
}

.task-top{
    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    gap:10px;
}

.task-title{
    font-size:14px;

    font-weight:750;

    line-height:1.35;
}

.star{
    border:0;

    background:none;

    color:#718197;

    cursor:pointer;

    font-size:20px;

    line-height:1;
}

.star.active{
    color:#ffd34d;

    text-shadow:
        0 0 12px rgba(255,211,77,.4);
}

.task-description{
    color:#a9b9cc;

    font-size:12px;

    line-height:1.5;

    margin:9px 0 12px;
}

.task-meta{
    display:flex;

    flex-wrap:wrap;

    gap:6px;
}

.badge{
    font-size:10px;

    padding:5px 8px;

    border-radius:20px;

    background:
        rgba(255,255,255,.08);

    color:#bdcad9;
}

.priority-high{
    color:#ff7885;
}

.priority-medium{
    color:#ffc55e;
}

.priority-low{
    color:#55e69b;
}

.task-actions{
    display:flex;

    gap:7px;

    margin-top:13px;
}

.task-actions button{
    flex:1;

    border:1px solid var(--border);

    background:
        rgba(255,255,255,.05);

    color:var(--text);

    padding:7px;

    border-radius:8px;

    cursor:pointer;

    font-size:11px;

    transition:.2s;
}

.task-actions button:hover{
