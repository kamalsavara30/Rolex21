========================================================= */

.modal{
    position:fixed;

    inset:0;

    display:none;

    align-items:center;
    justify-content:center;

    padding:20px;

    background:
        rgba(0,0,0,.68);

    backdrop-filter:blur(10px);

    z-index:1000;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:min(560px,100%);

    padding:25px;

    border-radius:23px;

    border:1px solid var(--border);

    background:#0b192b;

    box-shadow:
        0 30px 100px rgba(0,0,0,.55);
}

body.light .modal-box{
    background:white;
}

.modal-box h2{
    margin-bottom:20px;
}

.form-group{
    margin-bottom:14px;
}

.form-group label{
    display:block;

    margin-bottom:7px;

    color:var(--muted);

    font-size:12px;
}

.form-group input,
.form-group textarea,
.form-group select{
    width:100%;

    padding:12px;

    border-radius:10px;

    border:1px solid var(--border);

    outline:none;

    background:
        rgba(255,255,255,.05);

    color:var(--text);
}

.form-group textarea{
    min-height:90px;

    resize:vertical;
}

.form-row{
    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:12px;
}

.modal-actions{
    display:flex;

    gap:10px;

    margin-top:20px;
}

.cancel-btn,
.save-btn{
    flex:1;

    padding:12px;

    border-radius:10px;

    cursor:pointer;
}

.cancel-btn{
    border:1px solid var(--border);

    background:transparent;

    color:var(--text);
}

.save-btn{
    border:0;

    background:
        linear-gradient(
            135deg,
            var(--blue),
            var(--purple)
        );

    color:white;

    font-weight:750;
}

/* =========================================================
   NOTIFICATION
========================================================= */

.notification{
    position:fixed;

    right:25px;

    bottom:25px;

    min-width:290px;

    max-width:400px;

    padding:17px;

    border-radius:15px;

    background:#10243b;

    color:white;

    border:1px solid var(--border);

    box-shadow:var(--shadow);

    transform:translateX(140%);

